#!/usr/bin/env bash
# Portillon de conformité (install-gate.sh). Bloque le push si la garde mord.
set -e
cd "$(git rev-parse --show-toplevel)"
# ⛔ LE GEL DE LA TOUR FERME SA PORTE, PAS CELLE DE GIT. Un voisin qui mesure sur ce dépôt n'a rien
# pour m'arrêter : seule une relecture de courrier mordrait, et c'est précisément ce qu'on saute.
# Garde partagé, posé par BPx et généralisé par l'architecte le 2026-08-21 — il ne lit que le champ
# des dépôts (jamais le motif, texte libre) et laisse passer si la tour est injoignable.
bash ~/dev/bp/hub/tools/garde-fenetre.sh || exit 1
# ⛔ MON ÉTAT PUBLIÉ NE DOIT PAS RETARDER SUR CE QUE JE POUSSE. Tant qu'il retarde, mes voisins me
# mesurent à ma dernière publication : le 2026-09-03, le relevé des lecteurs d'un paquet me comptait
# encore SIX sites que ma tête avait déjà retirés, et le producteur ne pouvait pas retirer sa porte.
# Il MORD AU CROCHET SUIVANT, jamais sur la poussée en cours — c'est voulu : publier bâtit deux index,
# et une construction ne s'enchaîne jamais dans une commande de fond. Il compare deux empreintes.
# ⛔ IL S'APPELLE, IL NE SE RECOPIE PAS — une copie serait une seconde autorité — et son code de
# sortie REMONTE : un portillon qui appelle sans propager n'appelle pas.
bash ~/dev/bp/hub/tools/garde-publie-a-jour.sh || exit $?
export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then nvm use 20 >/dev/null 2>&1 || nvm use 22 >/dev/null 2>&1; fi
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then echo "[gate] ERREUR : Node 20+ requis (actuel $(node -v)). Push bloque."; exit 1; fi
echo "[gate] node $(node -v) — npm run arch (garde structurelle)…"
npm run arch --silent
if node -e "process.exit(require(\"./package.json\").scripts?.verify?0:1)" 2>/dev/null; then
  echo "[gate] npm run verify…"; npm run verify --silent
elif node -e "process.exit(require(\"./package.json\").scripts?.test?0:1)" 2>/dev/null; then
  echo "[gate] npm test (repli — pas de verify)…"; npm test --silent
fi
echo "[gate] vert — push autorise (typage : svelte-check, dans verify)."
