// drum.bp — drum pattern in 3 polymetric voices
// Translated from bp3-engine/library/examples/drum/grammar.gr

@core
@controls
@alphabet.western:midi

// Three voices: kick (C8), snare (C7), hihat (E7)
// Each voice has different durations → natural polymetry
S -> {
  !(chan:1, vel:120, staccato:96) C8 - - -,
  !(chan:1, vel:120, staccato:96) - C7 C7 C7,
  !(chan:1, vel:120, staccato:92) E7 E7 E7 E7 E7 E7 E7 E7
}
