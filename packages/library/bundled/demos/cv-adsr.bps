// CV: Acid Bass — ADSR filter envelope on resonant sawtooth
// TB-303 style: short attack, sharp decay, low sustain
// The filter opens on each phrase then closes

@mod
@core
@controls
@alphabet.western:browser
@tempo:138

// Modulateur descriptif : env1 EST une enveloppe adsr (sortie 0..1)
cv env1 : mod.adsr(attack:5, decay:150, sustain:0.2, release:400)

S -> Bass Bass Bass Bass

-----

@mode:random

// Branchement au point de paramètre : env1 module la coupure (cutoff) de CHAQUE note (sujet *)
Bass -> C2 C2 C3 C2 - C2 Eb2 C2 (*:cutoff: env1, wave:sawtooth, vel:100, filterQ:8) [weight:50]
Bass -> C2 - Eb2 F2 F#2 F2 Eb2 - (*:cutoff: env1, wave:sawtooth, vel:100, filterQ:8) [weight:30]
Bass -> C2 C2 C2 - G2 - Eb2 C2 (*:cutoff: env1, wave:sawtooth, vel:100, filterQ:8)
