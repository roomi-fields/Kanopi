// Csound intro (migré de csound-intro.kanopi).
// Une voix de code Csound → audio. Csound est le langage DSP de lignée MIT
// (Barry Vercoe, 1986, ~1700 opcodes). Évaluer la voix `synth` : le moteur
// démarre et les notes de la partition jouent. Ctrl+. pour couper.

@actor synth  transport.audio  eval.csound

S -> synth

synth -> `<CsoundSynthesizer>
<CsOptions>
-odac
</CsOptions>
<CsInstruments>
sr = 44100
ksmps = 32
nchnls = 2
0dbfs = 1

instr 1
  kEnv madsr 0.01, 0.1, 0.7, 0.1
  aOsc vco2 0.3 * kEnv, p4
  outs aOsc, aOsc
endin
</CsInstruments>
<CsScore>
; f 0 3600 garde le moteur vivant 1 h — requis en live coding.
f 0 3600
i 1 0 1 220
i 1 0.5 1 440
i 1 1 1 330
</CsScore>
</CsoundSynthesizer>`
