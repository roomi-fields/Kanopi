// @name: Not Reich
// @tagline: Steve Reich-style phasing by Thierry Montaudon (1997). MIDI output — select a MIDI device in Hardware to hear it
// @language: bpscript
// @outputs: midi
// @level: intermediate
// @tags: polymetric
//
// not-reich.bps — phasing (Steve Reich style) by Thierry Montaudon (1997)
// Translated from bp3-engine/library/experimental/not-reich/grammar.gr
//
// Progressive nested polymetry with dynamic volume

@core
@controls
@alphabet.western:midi
@settings.notreich

// --- Sub-grammar 1 @mode:random(striated, tempo:60) ---

@mode:random(striated, tempo:60)
S -> A' B' C' (chan:1, vel:50, volumecont, volume:80)

-----

// --- Sub-grammar 2 @mode:random ---

@mode:random
A' -> A A A A A A A A
B' -> B B B" B" C C D D D D E E E E
C' -> C C C D E E E E C D C D E E E E C C C B" B" B A A !(volume:80) A A A !(volume:0)

A -> {C4 -, !(vel:40) - E#3 G3, A#5, - D5}:1
B -> {A A, !(vel:60) C2}
B" -> {B, - F5}
C -> {B, {!(vel:55) - C5}}
D -> {B,- {C4 F5 E#4}}
E -> {D,D#4 F4 C5 G#3}
