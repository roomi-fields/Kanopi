let osc;

function setup() {
  createCanvas(300, 200);
  // p5.sound est embarqué (mode instance) : le p5 global porte les classes son.
  osc = new p5.Oscillator('sine');
  osc.freq(220);
  osc.amp(0.3);
  osc.start();
}

function draw() {
  background(20);
  noStroke();
  fill(0, 200, 255);
  const r = 60 + 30 * sin(frameCount * 0.05);
  ellipse(width / 2, height / 2, r, r);
}
