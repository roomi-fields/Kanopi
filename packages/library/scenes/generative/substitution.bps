// Substitution — réécriture en chaîne

core
alphabet.western:audio

// Structure
-----
S -> Phrase1 Phrase2

-----

// Expansion
mode:rnd
Phrase1 -> C4 D4 E4 F4 (vel:90)
Phrase1 -> E4 F4 G4 A4 (vel:80)
Phrase2 -> G4 F4 E4 D4 C4 _ _ (vel:100)
Phrase2 -> A4 G4 F4 E4 D4 C4 _ (vel:70)
