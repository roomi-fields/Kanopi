// @language: bpscript
// TRANSCRIPTION : le natif ecrit le /N ESPACE = forme LEGACY PERSISTANTE (decision
// hub 2026-07-16-tempo-slash-n-nu-legacy-persistant, RATIFIEE). En BPScript elle s ecrit
// ! (/N) dans le FLUX, et c est desormais sa SEULE forme : le suffixe colle [/N] a ete supprime
// du langage (decision Romain 2026-08-06). La distinction scopee (enter/exit) que ce commentaire
// opposait n existe donc plus -- l operateur de vitesse ne vit ni en suffixe de regle, ni colle.
// templates.bps — test des templates $/ &
// Traduit de bp3-engine/library/examples/templates/grammar.gr
// NOMS DE REGLES SUFFIXES `_r` : une tete de regle ne peut plus porter le nom d une note de
// l alphabet actif (decision 2026-07-28, hub). Le natif d origine garde SES noms : les passages
// de .gr cites dans ce fichier ne suivent donc PAS nos renommages. Production prouvee INCHANGEE :
// arbre derive compare EN ENTIER avant/apres, a graine fixe.
//
// 6 règles bidirectionnelles (<>) testant les templates avec
// différents opérateurs temporels. Chaque règle produit le même
// résultat structurel (A_r A_r ... A_r) mais avec des variations de tempo.

core
maxitems:20   // MaxItemsProduce=20 dans le reglage natif : le moteur s'arrete
                 // apres 20 items. Sans ce plafond l'enumeration part vers 100000 et
                 // certaines grammaires ne rendent jamais la main.
alphabet.western:midi
allitems

// Settings
tempo:60
striated

// Non-terminaux : S, A_r
// Terminal : C4 (gate:midi via western)

// --- Sous-grammaire 1 — templates bidirectionnels mode:rnd ---

// Règle 1 : A_r A_r avec scale 1/2 sur le dernier A_r (*1/2 en BP3)
-----
mode:rnd
S <> ! (*1/2) A_r A_r A_r
// Règle 2 : A_r A_r avec tempo doublé sur le dernier A_r
S <> A_r A_r ! (/2) A_r

// Règle 3 : A_r A_r avec speed doublé sur le dernier A_r (/2 en BP3)
S <> A_r A_r ! (/2) A_r

// Règle 4 : A_r A_r avec deux silences de durées rationnelles
S <> A_r A_r 1 3/2 A_r

// Règle 5 : template pur — $A_r définit le motif, &A_r le référence
S <> $A_r &A_r

// Règle 6 : template avec period notation
S <> A_r . A_r A_r . A_r A_r A_r . A_r

-----

// --- Sous-grammaire 2 — résolution terminale mode:rnd ---

mode:rnd
A_r <> C4
