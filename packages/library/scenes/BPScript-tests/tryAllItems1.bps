// @language: bpscript
// tryAllItems1.bps — Same as all-items but with Choice=3
// Traduit de bp3-engine/test-data/-gr.tryAllItems1

core
allitems
maxitems:500
alphabet.western:midi
flag Choice
flag Flag

-----
mode:rnd
S -> X Y [Flag=2] [Choice=3]

-----

mode:rnd
[Choice==1] [Flag-1] X -> C1 X
[Choice==2] X -> C2 X [repeat:1]
[Choice==3] X -> C3 X (weight:100-50)
X -> C4 [goto:3 1]
Y -> D3
X -> T

-----

// Sous-grammaire 3 — mode:rnd explicite, fidèle au natif (RND)
mode:rnd
T -> C5 [failed:3 2]
Y -> D6
