// @language: bpscript
core

maxitems:20   // MaxItemsProduce=20 dans le reglage natif : le moteur s'arrete
                 // apres 20 items. Sans ce plafond l'enumeration part vers 100000 et
                 // certaines grammaires ne rendent jamais la main.
tempo:400   // horloge du natif -se.koto3 : periode 150 ms par temps, soit 400 BPM.
             // Sans elle BPx tombe sur son defaut 60 BPM et toutes les durees derivent.
             // La Voie B est autosuffisante : l'horloge vit dans la scene, pas dans un -se BP3.

// TERMINAUX DECLARES DANS LA SCENE (decision Romain 2026-07-29 §5 : c'est la voie qui permet
// de declarer un terminal directement, sans passer par un alphabet). La DESTINATION n'est pas
// choisie ici, elle est LUE a la source : l'original -gr.koto1 charge -ho.abc1, qui est un
// fichier d'alphabet chargeant lui-meme -mi.abc1 (prototypes d'objets sonores). Ces symboles
// sonnent donc, et koto3.bps — meme alphabet -ho.abc1, deja verte dans ce corpus — declare
// exactement de cette facon. Sans declaration, seul 'd' etait refuse (a/b/c sont reconnus par
// leur presence en membre gauche des regles SUB) : la scene sonnait a moitie declaree.
a:midi
b:midi
c:midi
d:midi

-----
mode:rnd
S -> X X X X X X X X
X -> a
X -> b
-----
mode:sub
#? ? -> #? ?
?1 #? -> ?1 #?
a -> a (weight:5)
a b a -> a a (weight:30)
b -> b (weight:5)
b a b -> b b (weight:30)
#a b -> #a c b (weight:100-10)
c c c -> c a c
c a c -> b a b
?1 ?1 ?2 ?3 ?4 ?4 -> ?2 ?3
?1 ?1 ?1 -> ?1 (weight:10)
?1 ?1 -> ?1 (weight:10)
-----
mode:ord
? #? -> d #? (weight:1-1)
