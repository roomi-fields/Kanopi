// @language: bpscript
core

maxitems:25   // MaxItemsProduce=25 dans le reglage natif : le moteur s'arrete
                 // apres 25 items. Sans ce plafond l'enumeration part vers 100000 et
                 // certaines grammaires ne rendent jamais la main.
// tryLIN.bps — migré de bp3-engine/test-data/-gr.tryLIN (porter bp3ToScene, 2026-07-17)
// Round-trip fidèle (règles = -gr, modulo commentaires/espacement flags) ; AST BPx valide.

// TERMINAUX DECLARES DANS LA SCENE (decision Romain 2026-07-29 §5). Destination LUE a la
// source : l'original -gr.tryLIN charge -ho.abc, fichier d'alphabet chargeant -mi.abc — ces
// symboles sonnent. Sans declaration, 'a' et 'c' etaient refuses ('b' est reconnu par sa
// presence en membre gauche).
a:midi
b:midi
c:midi

-----
mode:ord
S -> X X X X X X X X X X X X X X X X X X
-----
mode:lin
X -> a
#b X -> #b b
X ? -> c Y ?
Y X -> c
