// @language: bpscript
tempo:360   // horloge du natif -se.hamsad : periode 167 ms par temps, soit 360 BPM.
             // Sans elle BPx tombe sur son defaut 60 BPM et toutes les durees derivent.
             // La Voie B est autosuffisante : l'horloge vit dans la scene, pas dans un -se BP3.
// Nadaka-1er-essai.bps — migré de bp3-engine/test-data/-gr.Nadaka-1er-essai (porter bp3ToScene, 2026-07-17)
// Round-trip fidèle (règles = -gr, modulo commentaires/espacement flags) ; AST BPx valide.
// NOMS DE REGLES SUFFIXES `_r` : une tete de regle ne peut plus porter le nom d une note de
// l alphabet actif (decision 2026-07-28, hub). Le natif d origine garde SES noms : les passages
// de .gr cites dans ce fichier ne suivent donc PAS nos renommages. Production prouvee INCHANGEE :
// arbre derive compare EN ENTIER avant/apres, a graine fixe.

// ANNOTATION 2026-07-27 — cette scene DIT desormais sa convention de notes ET son symbole.
// Le reglage d'origine (-se.hamsad) declare la convention INDIENNE (valeur 2 : sa, re, ga) ; onze
// grammaires du fonds la declarent, vina et vina2 annotent le meme alphabet. Le discriminant vient
// de la DONNEE, il n'a pas ete choisi.
// A8 n'a AUCUNE regle -- ni ici ni dans le .gr d'origine -- et n'est une note dans aucun alphabet :
// le moteur natif l'emet litteralement comme jeton. C'est une VARIABLE DE TRAVAIL (decision Romain
// 2026-07-27, voie 3). Sans cette declaration, annoter la convention faisait REFUSER la scene ;
// sans la convention, la resolution aval devinait 7040 Hz pour un symbole qui n'a pas de hauteur.
alphabet.bp3_indian:midi
var A8
-----
mode:random
S -> A32
A32 -> A8 A8 A8 A8
A32 -> G _ _ P N S N P N G _ P G R S N P N _ _ R _ _ G _ _ _ _ 4 (weight:0)
A32 -> G G G P P P N N N R R R G _ S _ G G G P P P N N N R R R G _ S _ (weight:0)
A32 -> G _ P _ N _ R _ G _ G P N R G S G P N R G S G P N R G S R G S R (weight:0)
-----
mode:lin
#? G -> #? ga4_r (weight:inf)
ga3_r G -> ga3_r ga3_r (weight:inf)
ga4_r G -> ga4_r ga4_r (weight:inf)
ga5_r G -> ga5_r ga5_r (weight:inf)
re5_r G -> re5_r ga5_r (weight:inf)
re5_r _ G -> re5_r _ ga5_r (weight:inf)
#re5_r G -> #re5_r ga4_r
re3_r R -> re3_r re3_r (weight:inf)
re4_r R -> re4_r re4_r (weight:inf)
sa5_r R -> sa5_r re5_r (weight:inf)
re5_r R -> re5_r re5_r (weight:inf)
ni4_r R -> ni4_r re5_r (weight:inf)
ni4_r _ R -> ni4_r _ re5_r (weight:inf)
#ni4_r R -> #ni4_r re4_r
ga4_r P -> ga4_r pa4_r (weight:inf)
ga4_r _ P -> ga4_r _ pa4_r (weight:inf)
pa4_r P -> pa4_r pa4_r (weight:inf)
pa3_r P -> pa3_r pa3_r (weight:inf)
ni4_r P -> ni4_r pa4_r (weight:inf)
ni5_r P -> ni5_r pa4_r (weight:inf)
ni3_r P -> ni3_r pa3_r (weight:inf)
P ga4_r -> pa4_r ga4_r (weight:inf)
P ni4_r -> pa4_r ni4_r (weight:inf)
ni3_r N -> ni3_r ni3_r (weight:inf)
ni4_r N -> ni4_r ni4_r (weight:inf)
pa3_r N -> pa3_r ni3_r (weight:inf)
pa4_r N -> pa4_r ni4_r (weight:inf)
pa4_r _ N -> pa4_r _ ni4_r (weight:inf)
sa4_r N -> sa4_r ni3_r (weight:inf)
#sa4_r N -> #sa4_r ni4_r
sa3_r S -> sa3_r sa3_r (weight:inf)
sa4_r S -> sa4_r sa4_r (weight:inf)
re4_r S -> re4_r sa4_r (weight:inf)
ni3_r S -> ni3_r sa4_r (weight:inf)
re5_r S -> re5_r sa5_r (weight:inf)
ni4_r S -> ni4_r sa5_r (weight:inf)
ga5_r S -> ga5_r sa5_r (weight:inf)
ga5_r _ S -> ga5_r _ sa5_r (weight:inf)
