// @language: bpscript
// transposition.bps — transpositions imbriquées par Harm Visser (1997)
// Traduit de bp3-engine/library/examples/transposition/grammar.gr
// NOMS DE REGLES SUFFIXES `_r` : une tete de regle ne peut plus porter le nom d une note de
// l alphabet actif (decision 2026-07-28, hub). Le natif d origine garde SES noms : les passages
// de .gr cites dans ce fichier ne suivent donc PAS nos renommages. Production prouvee INCHANGEE :
// arbre derive compare EN ENTIER avant/apres, a graine fixe.
//
// Polymétrie imbriquée avec transpositions progressives (+2, +4, +6)
// et répétition contrôlée par flag numtimes.
// Tr2/Tr4/Tr6 sont des non-terminaux résolus par SUB1 en _transpose().

@core
@controls
@alphabet.western:midi

// --- Sous-grammaire 1 @mode:random ---

@mode:random
S -> A_r [numtimes=5]
A_r -> {E1,A#1 F#1} {Tr2 D_r}
B_r -> {Tr2 A_r}
C_r -> {Tr4 B_r}
[numtimes-1] D_r -> - {Tr6 C_r {B_r}:1} {C_r}:1 [repeat:4]

-----

// --- Sous-grammaire 2 @mode:sub1 — résolution transpositions ---

@mode:sub1
Tr2 -> !(chromashift:2)
Tr4 -> !(chromashift:4)
Tr6 -> !(chromashift:6)
D_r -> lambda
