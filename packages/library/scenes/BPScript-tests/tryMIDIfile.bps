// @language: bpscript
// tryMIDIfile.bps — Test MIDI file output with volume control
// Traduit de bp3-engine/test-data/-gr.tryMIDIfile (Bernard, 1997)

core
alphabet.western:midi
transpose:1/2   // C4key=48 dans le reglage natif : Encode.c:674 et :865 appliquent
                 // key += (C4key - 60) A L'ENCODAGE, avant que le moindre axe de sortie ne voie la
                 // note -- la colonne transpos du natif vaut zero, ce n'est donc pas une
                 // transposition chez lui. MESURE (bp3-engine, binaire 3.5.1, empreinte 372dd047) :
                 // le natif rend A3 @ 220 Hz, unanime sur ses quatre axes. Cette ligne rejoint sa
                 // FREQUENCE et diverge de son NOM -- elle rend A4 @ 220 Hz. Le choix entre le nom
                 // ecrit et le nom natif est en arbitrage chez Romain, sur dix-neuf grammaires.

-----
mode:rnd
S -> A4 G4 C5 A5 A4 G4 C5 A5 (volume:127) (weight:1-1)
S -> A4 G4 C5 A5 A4 G4 C5 A5 (volume:64) (weight:1-1)
