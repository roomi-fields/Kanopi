// @language: bpscript
// visser3.bps — Harm Visser, structure avec transpositions et vélocité
// Traduit de BP3 grammar format
// NOMS DE REGLES SUFFIXES `_r` : une tete de regle ne peut plus porter le nom d une note de
// l alphabet actif (decision 2026-07-28, hub). Le natif d origine garde SES noms : les passages
// de .gr cites dans ce fichier ne suivent donc PAS nos renommages. Production prouvee INCHANGEE :
// arbre derive compare EN ENTIER avant/apres, a graine fixe.
//
// 3 sous-grammaires :
// 1. Structure macro (M1–M11) avec silences et periods
// 2. Dérivation des motifs avec transpositions et polymétrie
// 3. Résolution des symboles de transposition en contrôles

@core
@controls
@qclock:2
@alphabet.western:midi
@tempo:120

// --- Sous-grammaire 1 @mode:ord — structure ---

@mode:ord
S -> M1 M2 M3 M4 M5 M6 M7 M8 M9 M10 M11
M1 -> A_r -
M2 -> B_r - M1
M3 -> C_r - M2
M4 -> D_r - M3
M5 -> E_r . M4
M6 -> F_r - M5
M7 -> G_r - M6
M8 -> H - . M7
M9 -> I - M8
M10 -> J - .
M11 -> K

-----

// --- Sous-grammaire 2 @mode:ord — motifs avec transpositions ---

@mode:ord
A_r -> C3
B_r -> {Tr11 A_r}
C_r -> {Tr5 {A_r,B_r}}
D_r -> {Tr1 A_r C_r}
E_r -> {Tr7 {A_r -,D_r -}}
F_r -> {Tr6 A_r E_r D_r}
G_r -> {Tr11 {A_r B_r C_r D_r . E_r F_r E_r D_r C_r B_r A_r}}
H -> {Tr-11 {G_r F_r E_r D_r C_r B_r A_r}}
I -> {Tr11 G_r}
J -> {G_r F_r,Tr5 G_r F_r}
K -> {Tr-11 B_r C_r D_r}

-----

// --- Sous-grammaire 3 @mode:ord — résolution des transpositions ---

@mode:ord
Tr11 -> !(chromashift:11) !(vel:90)
Tr5 -> !(chromashift:5) !(vel:80)
Tr1 -> !(chromashift:1) !(vel:70)
Tr7 -> !(chromashift:7) !(vel:60)
Tr6 -> !(chromashift:6) !(vel:70)
Tr-11 -> !(chromashift:-11) !(vel:90)
