// multi-actor fixture (migré de multi-actor.kanopi) — Strudel (audio, banque
// dirt-samples déclarée sur l'acteur) + Hydra (vidéo), les deux armées dans une scène.
@actor beat  eval.strudel(bank:"dirt-samples")
@actor viz  eval.hydra

S -> { beat_r, viz_r }

beat_r -> beat.`note("c2*4").s("sawtooth").gain(0.5)`
viz_r  -> viz.`osc(60, 0.1, 1.5).out()`
