// Minimal p5 sketch: paint a solid background so canvas pixel sampling
// returns a clearly non-zero count. createCanvas binds the canvas to the
// p5 container; the draw loop keeps redrawing so any frame sampled is hot.
function setup() {
  createCanvas(400, 400);
  noStroke();
}
function draw() {
  background(40, 90, 180);
  fill(255, 200, 50);
  ellipse(200, 200, 200, 200);
}
