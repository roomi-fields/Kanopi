{
  "name": "@kanopi/ui",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/gen-icons.mjs",
    "build": "vite build",
    "build:prod": "VITE_BASE_PATH=/kanopi/ npm run build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "arch": "depcruise 'src/**/*.ts' --config .dependency-cruiser.cjs --output-type err",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "bash scripts/vitest-guard.sh vitest run -c vitest.config.ts",
    "e2e": "playwright test",
    "e2e:dev": "playwright test",
    "e2e:prod": "KANOPI_BASE_URL=https://roomi-fields.com/kanopi/ playwright test",
    "e2e:cross": "KANOPI_CROSS_BROWSER=1 playwright test",
    "e2e:prod:cross": "KANOPI_BASE_URL=https://roomi-fields.com/kanopi/ KANOPI_CROSS_BROWSER=1 playwright test",
    "e2e:visual:update": "playwright test tests/e2e/self-test/visual.spec.ts --update-snapshots",
    "verify": "npm run check && npm run lint && npm run build && npm run test && npm run e2e"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@csound/browser": "^7.0.0-beta31",
    "@hlolli/codemirror-lang-csound": "^1.0.0-alpha10",
    "@kairos/core": "file:../../../../bp/kairos",
    "@kronos/core": "file:../../../../bp/kronos",
    "@lezer/highlight": "^1.2.0",
    "@strudel/codemirror": "^1.3.0",
    "@strudel/mini": "^1.2.6",
    "@strudel/web": "^1.0.0",
    "bp3-frontend": "file:../../../../bp/bp3-frontend",
    "bpscript": "file:../../../../bp/BPscript",
    "bpx": "file:../../../../bp/BPx",
    "codemirror": "^6.0.1",
    "hydra-synth": "^1.3.29",
    "idb": "^8.0.0",
    "mercury-engine": "^1.7.0",
    "p5": "^2.2.3",
    "runtime-audio": "file:../../../../bp/runtime-audio",
    "runtime-codevoices": "file:../../../../bp/runtime-codevoices",
    "runtime-midi": "file:../../../../bp/runtime-MIDI",
    "runtime-osc": "file:../../../../bp/runtime-OSC",
    "runtime-ui": "file:../../../../bp/runtime-ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.45.0",
    "jsdom": "^25.0.0",
    "knip": "^6.22.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.0"
  }
}
