{
  "exclude": ["\\.(json|bps|gr|txt|d\\.ts)$"],
  "external": ["node_modules", "^svelte(/|$)", "^@codemirror", "^@?strudel", "^(hydra|p5|idb|mercury|csound)"],
  "blocks": [
    {"name":"KRONOS","match":"kronos/dist"},
    {"name":"KAIROS","match":"kairos/dist"},
    {"name":"BPx","match":"(BPx|bpx|bp3-frontend)"},
    {"name":"BPScript","match":"bpscript"},
    {"name":"RUNTIMES","match":"runtime-(midi|audio|osc|codevoices|ui)"},
    {"name":"coeur","match":"(^|/)core/src/|lib/(core|core-real|core-mock|events)(/|$)"},
    {"name":"UI","match":"(^|/)components(/|$)|App\\.svelte|(^|/)main\\.ts$|(^|/)app\\.|/styles/|lib/icons"},
    {"name":"stores","match":"(^|/)stores(/|$)"},
    {"name":"adaptateur","match":"lib/runtimes"},
    {"name":"bibliotheque","match":"lib/(library|devices)(/|$)"},
    {"name":"persistance","match":"lib/(persistence|workspace)(/|$)"},
    {"name":"commandes","match":"lib/(commands|keybindings)(/|$)"},
    {"name":"midi","match":"lib/midi(/|$)"},
    {"name":"texte","match":"lib/(blocks|text-order|format)(/|$)"},
    {"name":"divers","match":"(^|/)types(/|$)"}
  ]
}
