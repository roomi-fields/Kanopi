{
  "name": "kanopi",
  "version": "0.1.0-alpha",
  "description": "The VSCode of live coding — multi-runtime IDE with shared clock, scenes, and hardware surfaces.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "simple-git-hooks",
    "arch": "depcruise \"packages/ui/src/**/*.{ts,svelte}\" \"packages/core/src/**/*.js\" --config .dependency-cruiser.cjs --output-type err"
  },
  "simple-git-hooks": {
    "pre-push": "cd packages/ui && npm run verify"
  },
  "author": "roomi-fields",
  "license": "AGPL-3.0-or-later"
}
